NEXT_PUBLIC_APP_URL=http://localhost:3000
# Host (no scheme) the native Capacitor app uses for OAuth app-links.
# Must match Capacitor server.url host in capacitor.config.ts.
NEXT_PUBLIC_APP_LINK_HOST=qst-kappa.vercel.app
# Supabase project URL. If a Supabase custom Auth domain is configured
# (Project Settings -> Authentication -> URL Configuration), point this at it,
# e.g. https://auth.qst.rabidahal.com.np
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_GEMINI_API_KEY=
